{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mythos",
  "version": "0.7.0",
  "identifier": "dev.mrtn.mythos",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../web",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mythos",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Mythos, movies and series from your own server",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCRUNCNDlFMzk3REFDQTMKUldTanJIMDVuclRzQysrN1JRY3h1Szg2bFRUZEg1QnoydUlYZG5FSzZHWUx6YTdJNVZtMGlRdnAK",
      "endpoints": [
        "https://github.com/MartinSchubert04/Mythos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
