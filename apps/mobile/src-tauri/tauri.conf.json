{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mythos",
  "version": "0.5.0",
  "identifier": "dev.mrtn.mythos",
  "build": {
    "beforeDevCommand": { "script": "npm run dev -- --host", "cwd": "../../web", "wait": false },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../web" },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mythos",
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "shortDescription": "Mythos, movies and series from your own server"
  }
}
