# Configuración de Mythos (copiar a deploy/.env, que no se commitea).

# Primer admin: se crea solo si todavía no hay ningún usuario. Después se puede borrar de acá.
MYTHOS_ADMIN_USER=admin
MYTHOS_ADMIN_PASSWORD=cambiame-por-algo-largo

# nvenc = convertir en la GPU NVIDIA (recomendado si está); none = ffmpeg por CPU.
MYTHOS_HWACCEL=nvenc

# Tope de la caché de torrents en GB: se borran los menos usados que no se estén viendo.
MYTHOS_CACHE_GB=60

# Puerto de peers de BitTorrent (el mismo que se abre en el router). El contenedor usa la red del
# host, así que no hay que publicarlo en docker-compose.yml.
MYTHOS_PEER_PORT=42069

# Peers por torrent (entrantes y salientes juntos; 20–500). 200 va bien con el puerto abierto y
# entra holgado en la tabla NAT de un router de casa. Si al bajar se corta internet en la casa
# (tabla NAT llena), probá con 120.
# MYTHOS_PEER_LIMIT=200

# La app escucha en 127.0.0.1:7700 (fijo en docker-compose.yml; afuera por tailscale serve).
# Red de casa, opcional: la IP local del server con el mismo puerto la abre también a la LAN
# (http, sin cifrar; cualquiera en el WiFi llega al login). Sirve para un TV box sin Tailscale.
# No uses 0.0.0.0: choca con el 7700 de tailscale serve. Varias, separadas por coma.
# MYTHOS_EXTRA_BIND=192.168.0.100:7700

# Logs: info, o debug para ver cada request (p. ej. info,tower_http=debug).
RUST_LOG=info

# Opcionales (estos son los valores por defecto):
# MYTHOS_TORRENTIO_URL=https://torrentio.strem.fun
# "Top rated" baja los datasets públicos de IMDb (~240 MB por semana; guarda ~1,5 MB en
# data/imdb). 0 lo apaga.
# MYTHOS_IMDB=1
# MYTHOS_FFMPEG=ffmpeg
# MYTHOS_FFPROBE=ffprobe

# Solo para probar en local, NUNCA en el server: crea admin/admin y test/test.
# MYTHOS_DEV=1
